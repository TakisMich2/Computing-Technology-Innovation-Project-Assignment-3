# Copy this file to .env and keep that file out of version control. The supplied
# model's SHA-256 is prefilled; update it if you replace the model file.

# Path to the trained model and its SHA-256 hash. Get the hash by running
# python -m scripts.hash_model models/MODEL_FINAL.joblib from the backend folder.
MODEL_PATH=models/MODEL_FINAL.joblib
MODEL_SHA256=04b478c5fd5ee801e08499f7e32ef4bee92c6ce954f5b1d69767e8436a3d26c7
# Optional HTTPS address used by python -m scripts.download_model.
MODEL_URL=

# Front-end origins allowed by CORS, separated by commas. Don't use *.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Location of the built front end. The server serves it from / if it exists.
FRONTEND_DIST=../frontend/dist

# Request limits and inference capacity settings.
MAX_URL_LENGTH=2048
MAX_BODY_BYTES=8192
INFERENCE_WORKERS=2
MAX_QUEUED_REQUESTS=8
QUEUE_TIMEOUT_SECONDS=2

# Set to true to enable interactive API docs at /docs. Keep them off outside development.
ENABLE_DOCS=false

# For demonstration videos only: disable selected defences to show the
# before-and-after results. Separate names with commas and leave this empty
# for normal use:
#   dos       removes body and URL limits and the admission gate; inference runs on the event loop
#   model     loads the model without checking its hash
#   evasion   sends the original input to the model without normalising it
#   hardening turns off security headers, exposes /docs, and sends the Server header
DISABLED_DEFENCES=
